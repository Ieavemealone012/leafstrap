<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page2"
             x:DataType="vm:Page2ViewModel">
    <ScrollViewer>
        <StackPanel Spacing="4">
            <TextBlock Text="Choose where to install to" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Leafstrap uses the location shown below. Packaged macOS and Linux installations keep their platform-managed location."
                       FontSize="14" TextWrapping="Wrap" />

            <Border Margin="0,8,0,0" Padding="12" CornerRadius="4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Text="{Binding InstallLocation}" IsReadOnly="True" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="8,0,4,0" Command="{Binding BrowseInstallLocationCommand}" IsEnabled="{Binding CanChangeLocation}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:Lucide Icon="Folder" Width="16" Height="16"/><TextBlock Text="Browse"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Margin="4,0,0,0" Command="{Binding ResetInstallLocationCommand}" IsEnabled="{Binding CanChangeLocation}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:Lucide Icon="RotateCcw" Width="16" Height="16"/><TextBlock Text="Reset"/></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="Shortcuts" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Text="These shortcuts open Leafstrap's launch menu. More specific shortcuts can be created later in Settings."
                       FontSize="14" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                <controls:OptionControl Grid.Column="0" Margin="0,0,4,0" Header="Desktop icon">
                    <ToggleSwitch IsChecked="{Binding CreateDesktopShortcut}" />
                </controls:OptionControl>
                <controls:OptionControl Grid.Column="1" Margin="4,0,0,0" Header="Applications menu icon">
                    <ToggleSwitch IsChecked="{Binding CreateMenuShortcut}" />
                </controls:OptionControl>
            </Grid>

            <controls:OptionControl Header="Import Settings From" Description="Choose which application's settings to import into this installation.">
                <ComboBox Width="120" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="None" /></ComboBox>
            </controls:OptionControl>

            <Border Margin="0,4,0,0" Padding="10" CornerRadius="4" Background="#33FFC107" IsVisible="{Binding ShowPortableNotice}">
                <TextBlock Text="The AppImage will be copied into your user applications folder." FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
