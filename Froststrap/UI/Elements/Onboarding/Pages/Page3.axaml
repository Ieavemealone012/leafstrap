<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page3"
             x:DataType="vm:Page3ViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Leafstrap has been installed successfully." FontSize="14" Margin="0,4,0,8" />
        <controls:CardAction Header="Configure Leafstrap" Description="Open Settings and choose your themes, mods, integrations, and launch options." Icon="Settings" Command="{Binding LaunchSettingsCommand}" />
        <controls:CardAction Header="Launch Roblox" Description="Save your setup and start Roblox through Leafstrap." Icon="Gamepad2" Command="{Binding LaunchRobloxCommand}" />
    </StackPanel>
</UserControl>
