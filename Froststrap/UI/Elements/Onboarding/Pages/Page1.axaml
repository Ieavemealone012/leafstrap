<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page1"
             x:DataType="vm:Page1ViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="Thank you for downloading Leafstrap." FontSize="14" />
        <controls:MarkdownTextBlock
            MarkdownText="The only official source to download Leafstrap from is [github.com/Ieavemealone012/leafstrap](https://github.com/Ieavemealone012/leafstrap), so please verify that you have downloaded it from the official source."
            FontSize="14" TextWrapping="Wrap" />
        <TextBlock Text="This installation process will be quick and simple, and you will be able to configure all of Leafstrap's settings after installation."
                   FontSize="14" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
