<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.LaunchMenuDialog"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
                     xmlns:models="clr-namespace:Froststrap.UI.ViewModels"
                     xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
                     xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                     x:DataType="vm:LaunchMenuViewModel"
                     Title="Leafstrap"
                     Width="580"
                     SizeToContent="Height"
                     CanResize="False"
                     WindowStartupLocation="CenterScreen"
                     mc:Ignorable="d">

    <!-- Cross-platform counterpart of the Windows Leafstrap launch menu. -->
    <Grid Margin="20,14,20,18" ColumnDefinitions="260,*" ColumnSpacing="12">
        <Grid Grid.Column="0" RowDefinitions="*,Auto" MinHeight="200">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <Image Width="72" Height="72"
                       Source="avares://Leafstrap/Leafstrap.png"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="LaunchTitle"
                               Text="Leafstrap"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding Version}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                <controls:IconButton Icon="CircleQuestionMark"
                                     Content="About Leafstrap"
                                     Command="{Binding LaunchAboutCommand}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <controls:IconButton Icon="MessageCircleMore"
                                     Content="Join our Discord server"
                                     Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                                     CommandParameter="https://discord.gg/KdR9vpRcUN"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Spacing="8">
            <Button Height="62"
                    Padding="16,0"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding LaunchRobloxCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ic:Lucide Icon="Gamepad2" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="Launch Roblox" FontSize="14" VerticalAlignment="Center" />
                    <ic:Lucide Grid.Column="2" Icon="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Height="54"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding LaunchSettingsCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ic:Lucide Icon="Settings" Width="21" Height="21" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="Settings" VerticalAlignment="Center" />
                        <ic:Lucide Grid.Column="2" Icon="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Grid.Column="1"
                        Height="54"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding LaunchRobloxStudioCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ic:Lucide Icon="Wrench" Width="21" Height="21" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="Studio" VerticalAlignment="Center" />
                        <ic:Lucide Grid.Column="2" Icon="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

            <Button Height="70"
                    Margin="0,10,0,0"
                    Padding="16,0"
                    HorizontalContentAlignment="Stretch"
                    Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                    CommandParameter="https://github.com/Ieavemealone012/leafstrap/wiki">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ic:Lucide Icon="BookOpenText" Width="22" Height="22" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Having an issue?" FontSize="14" />
                        <TextBlock Text="See the Wiki for help" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ic:Lucide Grid.Column="2" Icon="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</base:AvaloniaWindow>
