<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StyleInclude Source="avares://Leafstrap/UI/AppThemes/Styles/Dark.axaml" />
    <Style Selector="ProgressBar.Square">
        <Setter Property="Background" Value="#2A1B32" />
        <Setter Property="Foreground" Value="#FF7A00" />
        <Setter Property="BorderBrush" Value="#704128" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</Styles>
