<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="NewTextEditorBackground" Color="#0A1728"/><SolidColorBrush x:Key="NewTextEditorForeground" Color="White"/><SolidColorBrush x:Key="NewTextEditorLink" Color="#80B8FF"/><SolidColorBrush x:Key="CompletionListBackgroundBrush" Color="#F2122A48"/>
  <SolidColorBrush x:Key="NormalDarkAndLightBackground" Color="#D9122A48"/><SolidColorBrush x:Key="NotificationBackgroundColor" Color="#F2122A48"/>
  <LinearGradientBrush x:Key="ApplicationBackgroundColor" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FF0A1B32" Offset="0"/><GradientStop Color="#FF174F91" Offset="0.52"/><GradientStop Color="#FF2A79D9" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#26152334"/><SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#381A2C40"/><SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4A20364E"/><SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#65535F70"/><SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#08000000"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="#08000000"/><SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White"/><SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9FFFFFF"/><SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A6FFFFFF"/>
</ResourceDictionary>
