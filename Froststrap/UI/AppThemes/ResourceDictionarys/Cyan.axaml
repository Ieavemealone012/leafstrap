<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="NewTextEditorBackground" Color="#081B20"/><SolidColorBrush x:Key="NewTextEditorForeground" Color="White"/><SolidColorBrush x:Key="NewTextEditorLink" Color="#55EAF2"/><SolidColorBrush x:Key="CompletionListBackgroundBrush" Color="#F20B2830"/>
  <SolidColorBrush x:Key="NormalDarkAndLightBackground" Color="#D90B2830"/><SolidColorBrush x:Key="NotificationBackgroundColor" Color="#F20B2830"/>
  <LinearGradientBrush x:Key="ApplicationBackgroundColor" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FF08232C" Offset="0"/><GradientStop Color="#FF075B69" Offset="0.52"/><GradientStop Color="#FF00A9BA" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#26132D34"/><SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#38143239"/><SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4A163941"/><SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#65537075"/><SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#08000000"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="#08000000"/><SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White"/><SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9FFFFFF"/><SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A6FFFFFF"/>
</ResourceDictionary>
