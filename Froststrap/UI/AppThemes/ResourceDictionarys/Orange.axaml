<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="NewTextEditorBackground" Color="#24150A"/><SolidColorBrush x:Key="NewTextEditorForeground" Color="White"/><SolidColorBrush x:Key="NewTextEditorLink" Color="#FFC078"/><SolidColorBrush x:Key="CompletionListBackgroundBrush" Color="#F238210E"/>
  <SolidColorBrush x:Key="NormalDarkAndLightBackground" Color="#D938210E"/><SolidColorBrush x:Key="NotificationBackgroundColor" Color="#F238210E"/>
  <LinearGradientBrush x:Key="ApplicationBackgroundColor" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FF2C1809" Offset="0"/><GradientStop Color="#FF8A440F" Offset="0.52"/><GradientStop Color="#FFE47719" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#262A1D14"/><SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#38352418"/><SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4A412C1C"/><SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#65665B53"/><SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#08000000"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="#08000000"/><SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White"/><SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9FFFFFF"/><SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A6FFFFFF"/>
</ResourceDictionary>
