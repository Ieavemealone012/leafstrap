<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="NewTextEditorBackground" Color="#260F22"/><SolidColorBrush x:Key="NewTextEditorForeground" Color="White"/><SolidColorBrush x:Key="NewTextEditorLink" Color="#FF9BD5"/><SolidColorBrush x:Key="CompletionListBackgroundBrush" Color="#F23B1734"/>
  <SolidColorBrush x:Key="NormalDarkAndLightBackground" Color="#D93B1734"/><SolidColorBrush x:Key="NotificationBackgroundColor" Color="#F23B1734"/>
  <LinearGradientBrush x:Key="ApplicationBackgroundColor" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FF2B1027" Offset="0"/><GradientStop Color="#FF7B285F" Offset="0.52"/><GradientStop Color="#FFD64B9E" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#262C1728"/><SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#38391D33"/><SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4A472440"/><SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#65695363"/><SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#08000000"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="#08000000"/><SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White"/><SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9FFFFFF"/><SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A6FFFFFF"/>
</ResourceDictionary>
