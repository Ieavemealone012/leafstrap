<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="NewTextEditorBackground" Color="#170D24"/><SolidColorBrush x:Key="NewTextEditorForeground" Color="White"/><SolidColorBrush x:Key="NewTextEditorLink" Color="#C59AF4"/><SolidColorBrush x:Key="CompletionListBackgroundBrush" Color="#F2251537"/>
  <SolidColorBrush x:Key="NormalDarkAndLightBackground" Color="#D9251537"/><SolidColorBrush x:Key="NotificationBackgroundColor" Color="#F2251537"/>
  <LinearGradientBrush x:Key="ApplicationBackgroundColor" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FF1B1028" Offset="0"/><GradientStop Color="#FF512A73" Offset="0.52"/><GradientStop Color="#FF8E44CE" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#261E1428"/><SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#38271A34"/><SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4A30203F"/><SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#655C5263"/><SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#08000000"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="#08000000"/><SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White"/><SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9FFFFFF"/><SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A6FFFFFF"/>
</ResourceDictionary>
