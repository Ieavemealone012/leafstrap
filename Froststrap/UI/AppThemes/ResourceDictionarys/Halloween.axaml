<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#120D17" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#FFF5E9" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#FF9A3C" />
    <SolidColorBrush x:Key="CompletionListBackgroundBrush" Color="#F221152A" />
    <SolidColorBrush x:Key="NormalDarkAndLightBackground" Color="#D924172E" />
    <SolidColorBrush x:Key="NotificationBackgroundColor" Color="#F224172E" />

    <LinearGradientBrush x:Key="ApplicationBackgroundColor"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%">
        <GradientStop Color="#FF100B15" Offset="0" />
        <GradientStop Color="#FF21102B" Offset="0.55" />
        <GradientStop Color="#FF4A1B08" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#332D1B34" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#47281730" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#5C321B38" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B8211728" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#12000000" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0D000000" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFF5E9" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#E6FFE8D1" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#BFDDBFAD" />
</ResourceDictionary>
